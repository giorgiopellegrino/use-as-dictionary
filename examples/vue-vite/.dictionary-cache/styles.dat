:root{--demo-stylesheet-version:2;color:#213b30;font-synthesis:none;text-rendering:optimizelegibility;-webkit-font-smoothing:antialiased;--ink:#213b30;--muted:#68756b;--paper:#fff;--line:#dee4d9;--accent:#d4eb77;--green:#466447;background:#f5f5ef;font-family:Inter,Segoe UI,Helvetica,Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0}button,input{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit}button{cursor:pointer}button:disabled{cursor:wait;opacity:.6}a:focus-visible,button:focus-visible,summary:focus-visible{outline-offset:5px;outline:3px solid #7f9840}::selection{color:var(--ink);background:var(--accent)}h1,h2,h3,p{margin:0}code{font-family:Cascadia Code,SFMono-Regular,Consolas,monospace;font-size:.9em}.site-shell{width:min(1120px,100% - 64px);margin:0 auto}.site-header{border-bottom:1px solid var(--line);justify-content:space-between;align-items:center;gap:24px;min-height:100px;display:flex}.wordmark{letter-spacing:-.3px;align-items:center;gap:12px;font-size:15px;text-decoration:none;display:inline-flex}.wordmark strong{font-weight:650}.brand-icon{background:var(--ink);width:35px;height:35px;color:var(--accent);border-radius:10px;place-items:center;font-family:monospace;font-size:15px;font-weight:700;display:grid}.stack-label{color:var(--muted);align-items:center;gap:8px;font-size:12px;display:inline-flex}.status-dot{background:#8b9687;border-radius:50%;flex-shrink:0;width:7px;height:7px;display:inline-block}.hero{grid-template-columns:1.1fr 1fr;align-items:center;gap:64px;padding:76px 0 72px;display:grid}.eyebrow{color:var(--green);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:18px;font-size:11px;font-weight:700}h1{letter-spacing:-2.2px;font-size:clamp(34px,4.1vw,53px);font-weight:650;line-height:1.1}h1 span{box-shadow:inset 0 -.24em var(--accent);display:inline}.hero-description{color:var(--muted);max-width:430px;margin:25px 0 23px;font-size:15px;line-height:1.8}.text-link{align-items:center;gap:10px;font-size:12px;font-weight:650;text-decoration:none;display:inline-flex}.text-link:hover{text-underline-offset:4px;text-decoration:underline}.text-link span{font-size:16px}.flow-card{background:#ebefdf;border:1px solid #e0e6d3;border-radius:20px;padding:27px}.flow-card-heading{color:var(--green);align-items:center;gap:8px;margin-bottom:26px;font-size:12px;display:flex}.file-icon{font-family:monospace;font-size:13px;font-weight:700}.flow-line{background:#f5f7ef;border:1px solid #d7decc;border-radius:10px;align-items:center;gap:12px;padding:18px 15px;display:flex}.flow-line div{flex:1;gap:5px;display:grid}.flow-line strong{font-size:13px;font-weight:650}.flow-line div span{color:var(--muted);font-size:10px}.version-chip{width:34px;height:36px;color:var(--green);background:#e4e9d9;border-radius:7px;place-items:center;font-family:monospace;font-size:12px;display:grid}.version-chip-dark{color:var(--accent);background:var(--ink)}.flow-check{color:var(--green)}.flow-connector{color:#6c7e58;align-items:center;gap:17px;padding:8px 11px;display:flex}.flow-connector>span{margin-left:14px;font-size:22px}.flow-connector small{font-size:10px}.flow-line-highlight{background:var(--paper);border-color:#becaab;box-shadow:0 4px 10px #213b3005}.flow-line>code{background:#edf5d4;border:1px solid #dce8bb;border-radius:4px;padding:3px 6px;font-size:10px}.flow-caption{color:#6c795d;text-align:center;margin-top:20px;font-size:10px;line-height:1.5}.section-heading{justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:22px;display:flex}.section-heading .eyebrow{margin-bottom:10px}h2{letter-spacing:-.8px;font-size:25px;font-weight:620;line-height:1.25}.subtle-label{color:var(--muted);margin-bottom:3px;font-size:11px}.metric-grid{grid-template-columns:repeat(3,1fr);gap:14px;display:grid}.metric-card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:23px}.metric-label{color:var(--muted);justify-content:space-between;align-items:center;gap:6px;font-size:11px;display:flex}.metric-label code{opacity:.75;border:1px solid;border-radius:4px;padding:1px 5px;font-size:10px}.metric-value{letter-spacing:-1.1px;font-variant-numeric:tabular-nums;margin:16px 0 18px;font-size:31px;font-weight:600;line-height:1;display:block}.metric-track{background:#edf0e9;border-radius:5px;height:5px;margin-bottom:17px;overflow:hidden}.metric-bar{border-radius:inherit;height:100%;display:block}.bar-original{background:#b8c2b1}.bar-brotli{background:#798f66}.bar-dcb{background:var(--accent)}.metric-card>p{color:var(--muted);font-size:10px;line-height:1.7}.metric-card-featured{color:#fff;background:var(--ink);border-color:var(--ink)}.metric-card-featured .metric-label,.metric-card-featured>p{color:#d3dece}.metric-card-featured .metric-track{background:#405648}.metric-card-featured>p strong{color:var(--accent)}.measurement-note{color:var(--muted);max-width:930px;margin:17px 0 0;font-size:11px;line-height:1.9}.measurement-note strong{color:#536449;font-weight:600}.steps-section{margin-top:58px}.steps-grid{border-top:1px solid var(--line);border-bottom:1px solid var(--line);grid-template-columns:repeat(3,1fr);display:grid}.step-card{padding:27px 27px 27px 0}.step-card+.step-card{border-left:1px solid var(--line);padding-left:27px}.step-number{width:24px;height:24px;color:var(--green);background:#e9eddf;border-radius:50%;place-items:center;margin-bottom:16px;font-family:monospace;font-size:11px;display:inline-grid}h3{letter-spacing:-.2px;font-size:14px;font-weight:650}.step-card p{color:var(--muted);margin-top:10px;font-size:12px;line-height:1.85}.step-tag{color:var(--green);border-bottom:1px solid #dce3ce;margin-top:19px;padding-bottom:3px;font-size:10px;display:inline-block}.probe-section{background:#e9eddf;border:1px solid #dfe5d4;border-radius:16px;grid-template-columns:1fr 1fr;gap:64px;margin-top:55px;padding:34px;display:grid}.probe-copy .eyebrow{margin-bottom:12px}.probe-copy>p:not(.eyebrow){color:var(--muted);max-width:360px;margin-top:13px;font-size:12px;line-height:1.85}.primary-button{background:var(--ink);color:#fff;border:0;border-radius:7px;justify-content:space-between;align-items:center;gap:30px;margin-top:24px;padding:13px 17px;font-size:12px;font-weight:550;transition:background .15s,transform .15s;display:flex}.primary-button:hover:not(:disabled){background:#365840;transform:translateY(-1px)}.primary-button>span:last-child{color:var(--accent);font-size:16px}.devtools-link{width:fit-content;color:var(--green);margin-top:14px;font-size:10px;font-weight:500;display:flex}.probe-result{background:#f9fbf5;border:1px solid #d5dec7;border-radius:10px;align-self:stretch;min-height:230px;padding:20px}.probe-status{color:var(--green);border-bottom:1px solid #e3e9da;align-items:center;gap:7px;padding-bottom:13px;font-size:10px;display:flex}.dot-success{background:#488149}.dot-fallback{background:#b38c38}.probe-placeholder{text-align:center;color:var(--muted);padding:15px 0 7px}.placeholder-icon{color:#8b9b78;margin-bottom:9px;font-size:26px;display:block}.probe-placeholder p{font-size:11px;line-height:1.7}.probe-placeholder code{color:#7d8d6d;margin-top:14px;font-size:10px;display:inline-block}.result-list{margin:15px 0 0}.result-list>div{justify-content:space-between;align-items:center;gap:10px;padding:8px 0;display:flex}.result-list dt{color:var(--muted);font-size:10px}.result-list dd{font-variant-numeric:tabular-nums;margin:0;font-size:12px;font-weight:650}.result-list code{color:var(--green);background:#e7eedc;border-radius:3px;padding:2px 6px}.result-message{color:var(--muted);margin-top:15px;font-size:10px;line-height:1.8}.error-message{color:#944830}.details-section{max-width:920px;padding:45px 0 0}.details-section h2{letter-spacing:-.4px;margin-bottom:14px;font-size:18px}.details-section>p{color:var(--muted);margin-top:10px;font-size:11px;line-height:1.9}.details-section p code{color:#536449;overflow-wrap:anywhere;background:#e9eddf;border-radius:3px;padding:2px 4px}.artifact-details{border-top:1px solid var(--line);margin-top:23px}.artifact-details summary{cursor:pointer;justify-content:space-between;align-items:center;padding:17px 0;font-size:12px;font-weight:600;list-style:none;display:flex}.artifact-details summary::-webkit-details-marker{display:none}.artifact-details summary>span{font-size:18px;font-weight:400}.artifact-details[open] summary>span{transform:rotate(45deg)}.artifact-list{background:#edf0e6;border-radius:7px;margin:0 0 20px;padding:15px 20px}.artifact-list>div{grid-template-columns:100px 1fr;gap:15px;padding:5px 0;font-size:11px;line-height:1.8;display:grid}.artifact-list dt{color:var(--muted)}.artifact-list dd{overflow-wrap:anywhere;margin:0}.artifact-list a{text-underline-offset:3px}.notice{border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:25px;font-size:13px;line-height:1.8}.notice-error{color:#944830;background:#fff9f6;border-color:#e6c7bc}.site-footer{border-top:1px solid var(--line);color:var(--muted);justify-content:space-between;align-items:center;gap:20px;margin-top:45px;padding:25px 0 30px;font-size:10px;display:flex}.site-footer>span:first-child{color:var(--ink);font-weight:600}@media (width<=900px){.hero{gap:30px;padding:55px 0}h1{font-size:39px}.flow-card{padding:20px}.flow-line{gap:9px;padding:15px 10px}.flow-line div span{font-size:9px}.metric-card{padding:20px 16px}.metric-label{font-size:10px}.probe-section{gap:30px;padding:28px}}@media (width<=680px){.site-shell{width:calc(100% - 36px)}.site-header{gap:10px;min-height:76px}.wordmark{gap:8px;font-size:12px}.brand-icon{border-radius:8px;width:29px;height:29px;font-size:13px}.stack-label{gap:5px;font-size:9px}.hero{grid-template-columns:1fr;gap:30px;padding:40px 0}h1{letter-spacing:-1.7px;font-size:clamp(33px,8.5vw,47px)}.hero-description{margin-top:20px;font-size:14px}.flow-card{padding:23px}.flow-line{padding:17px 13px}.flow-line div span{font-size:10px}h2{font-size:22px}.section-heading{flex-direction:column;align-items:flex-start;gap:9px}.metric-grid{grid-template-columns:1fr;gap:10px}.metric-card{padding:22px}.metric-label{font-size:12px}.metric-value{font-size:33px}.metric-card>p,.measurement-note{font-size:11px}.steps-section{margin-top:38px}.steps-grid{grid-template-columns:1fr}.step-card{padding:24px 0}.step-card+.step-card{border-left:0;border-top:1px solid var(--line);padding:24px 0}.step-number{margin-bottom:11px}.step-card p{font-size:13px}.step-tag{margin-top:13px}.probe-section{grid-template-columns:1fr;gap:25px;margin-top:35px;padding:24px 18px}.probe-copy>p:not(.eyebrow){max-width:none;font-size:13px}.probe-result{min-height:220px}.details-section{padding-top:32px}.details-section>p{font-size:12px}.artifact-list{padding:15px}.artifact-list>div{grid-template-columns:1fr;gap:0;padding:7px 0}.site-footer{flex-direction:column;align-items:flex-start;gap:9px;margin-top:30px}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.primary-button{transition:none}}
/*$vite$:1*/