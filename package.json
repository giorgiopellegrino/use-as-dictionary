{
  "name": "use-as-dictionary",
  "version": "1.0.0",
  "private": true,
  "description": "Webpack plugin for Compression Dictionary Transport with Shared Brotli dictionaries",
  "main": "./src/CompressionDictionaryPlugin.cjs",
  "exports": {
    ".": "./src/CompressionDictionaryPlugin.cjs"
  },
  "files": [
    "src/"
  ],
  "license": "MIT",
  "author": "Giorgio Pellegrino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giorgiopellegrino/use-as-dictionary.git"
  },
  "homepage": "https://github.com/giorgiopellegrino/use-as-dictionary#readme",
  "bugs": {
    "url": "https://github.com/giorgiopellegrino/use-as-dictionary/issues"
  },
  "keywords": [
    "webpack",
    "webpack-plugin",
    "compression-dictionary-transport",
    "brotli",
    "dcb"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/vue-webpack"
  ],
  "scripts": {
    "build": "npm run build --workspace @use-as-dictionary/example-vue-webpack",
    "build:watch": "npm run build:watch --workspace @use-as-dictionary/example-vue-webpack",
    "serve": "npm run serve --workspace @use-as-dictionary/example-vue-webpack",
    "start": "npm start --workspace @use-as-dictionary/example-vue-webpack",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:plugin": "node --test test/production-plugin.test.cjs",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/check-package.cjs"
  },
  "dependencies": {
    "brotli-wasm-custom-dictionary": "3.1.1"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "webpack": "5.111.1"
  }
}
