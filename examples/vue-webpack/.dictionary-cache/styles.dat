:root{--demo-stylesheet-version:2;background:#f5f5ef;color:#213b30;font-family:Inter,Segoe UI,Helvetica,Arial,sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--ink:#213b30;--muted:#68756b;--paper:#fff;--line:#dee4d9;--accent:#d4eb77;--green:#466447}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0}button,input{font:inherit}a,button{-webkit-tap-highlight-color:transparent}a{color:inherit}button{cursor:pointer}button:disabled{cursor:wait;opacity:.6}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #7f9840;outline-offset:5px}::selection{background:var(--accent);color:var(--ink)}h1,h2,h3,p{margin:0}code{font-family:Cascadia Code,SFMono-Regular,Consolas,monospace;font-size:.9em}.site-shell{margin:0 auto;width:min(1120px,calc(100% - 64px))}.site-header{align-items:center;border-bottom:1px solid var(--line);display:flex;gap:24px;justify-content:space-between;min-height:100px}.wordmark{align-items:center;display:inline-flex;font-size:15px;gap:12px;letter-spacing:-.3px;text-decoration:none}.wordmark strong{font-weight:650}.brand-icon{background:var(--ink);border-radius:10px;color:var(--accent);display:grid;font-family:monospace;font-size:15px;font-weight:700;height:35px;place-items:center;width:35px}.stack-label{align-items:center;color:var(--muted);display:inline-flex;font-size:12px;gap:8px}.status-dot{background:#8b9687;border-radius:50%;display:inline-block;flex-shrink:0;height:7px;width:7px}.hero{align-items:center;display:grid;gap:64px;grid-template-columns:1.1fr 1fr;padding:76px 0 72px}.eyebrow{color:var(--green);font-size:11px;font-weight:700;letter-spacing:1.5px;margin-bottom:18px;text-transform:uppercase}h1{font-size:clamp(34px,4.1vw,53px);font-weight:650;letter-spacing:-2.2px;line-height:1.1}h1 span{box-shadow:inset 0 -.24em var(--accent);display:inline}.hero-description{color:var(--muted);font-size:15px;line-height:1.8;margin:25px 0 23px;max-width:430px}.text-link{align-items:center;display:inline-flex;font-size:12px;font-weight:650;gap:10px;text-decoration:none}.text-link:hover{text-decoration:underline;text-underline-offset:4px}.text-link span{font-size:16px}.flow-card{background:#ebefdf;border:1px solid #e0e6d3;border-radius:20px;padding:27px}.flow-card-heading{align-items:center;color:var(--green);display:flex;font-size:12px;gap:8px;margin-bottom:26px}.file-icon{font-family:monospace;font-size:13px;font-weight:700}.flow-line{align-items:center;background:#f5f7ef;border:1px solid #d7decc;border-radius:10px;display:flex;gap:12px;padding:18px 15px}.flow-line div{display:grid;flex:1;gap:5px}.flow-line strong{font-size:13px;font-weight:650}.flow-line div span{color:var(--muted);font-size:10px}.version-chip{background:#e4e9d9;border-radius:7px;color:var(--green);display:grid;font-family:monospace;font-size:12px;height:36px;place-items:center;width:34px}.version-chip-dark{background:var(--ink);color:var(--accent)}.flow-check{color:var(--green)}.flow-connector{align-items:center;color:#6c7e58;display:flex;gap:17px;padding:8px 11px}.flow-connector>span{font-size:22px;margin-left:14px}.flow-connector small{font-size:10px}.flow-line-highlight{background:var(--paper);border-color:#becaab;box-shadow:0 4px 10px #213b3005}.flow-line>code{background:#edf5d4;border:1px solid #dce8bb;border-radius:4px;font-size:10px;padding:3px 6px}.flow-caption{color:#6c795d;font-size:10px;line-height:1.5;margin-top:20px;text-align:center}.section-heading{align-items:flex-end;display:flex;gap:20px;justify-content:space-between;margin-bottom:22px}.section-heading .eyebrow{margin-bottom:10px}h2{font-size:25px;font-weight:620;letter-spacing:-.8px;line-height:1.25}.subtle-label{color:var(--muted);font-size:11px;margin-bottom:3px}.metric-grid{display:grid;gap:14px;grid-template-columns:repeat(3,1fr)}.metric-card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:23px}.metric-label{align-items:center;color:var(--muted);display:flex;font-size:11px;gap:6px;justify-content:space-between}.metric-label code{border:1px solid;border-radius:4px;font-size:10px;opacity:.75;padding:1px 5px}.metric-value{display:block;font-size:31px;font-variant-numeric:tabular-nums;font-weight:600;letter-spacing:-1.1px;line-height:1;margin:16px 0 18px}.metric-track{background:#edf0e9;border-radius:5px;height:5px;margin-bottom:17px;overflow:hidden}.metric-bar{border-radius:inherit;display:block;height:100%}.bar-original{background:#b8c2b1}.bar-brotli{background:#798f66}.bar-dcb{background:var(--accent)}.metric-card>p{color:var(--muted);font-size:10px;line-height:1.7}.metric-card-featured{background:var(--ink);border-color:var(--ink);color:#fff}.metric-card-featured .metric-label,.metric-card-featured>p{color:#d3dece}.metric-card-featured .metric-track{background:#405648}.metric-card-featured>p strong{color:var(--accent)}.measurement-note{color:var(--muted);font-size:11px;line-height:1.9;margin:17px 0 0;max-width:930px}.measurement-note strong{color:#536449;font-weight:600}.steps-section{margin-top:58px}.steps-grid{border-bottom:1px solid var(--line);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr)}.step-card{padding:27px 27px 27px 0}.step-card+.step-card{border-left:1px solid var(--line);padding-left:27px}.step-number{background:#e9eddf;border-radius:50%;color:var(--green);display:inline-grid;font-family:monospace;font-size:11px;height:24px;margin-bottom:16px;place-items:center;width:24px}h3{font-size:14px;font-weight:650;letter-spacing:-.2px}.step-card p{color:var(--muted);font-size:12px;line-height:1.85;margin-top:10px}.step-tag{border-bottom:1px solid #dce3ce;color:var(--green);display:inline-block;font-size:10px;margin-top:19px;padding-bottom:3px}.probe-section{background:#e9eddf;border:1px solid #dfe5d4;border-radius:16px;display:grid;gap:64px;grid-template-columns:1fr 1fr;margin-top:55px;padding:34px}.probe-copy .eyebrow{margin-bottom:12px}.probe-copy>p:not(.eyebrow){color:var(--muted);font-size:12px;line-height:1.85;margin-top:13px;max-width:360px}.primary-button{align-items:center;background:var(--ink);border:0;border-radius:7px;color:#fff;display:flex;font-size:12px;font-weight:550;gap:30px;justify-content:space-between;margin-top:24px;padding:13px 17px;transition:background .15s ease,transform .15s ease}.primary-button:hover:not(:disabled){background:#365840;transform:translateY(-1px)}.primary-button>span:last-child{color:var(--accent);font-size:16px}.devtools-link{color:var(--green);display:flex;font-size:10px;font-weight:500;margin-top:14px;width:fit-content}.probe-result{align-self:stretch;background:#f9fbf5;border:1px solid #d5dec7;border-radius:10px;min-height:230px;padding:20px}.probe-status{align-items:center;border-bottom:1px solid #e3e9da;color:var(--green);display:flex;font-size:10px;gap:7px;padding-bottom:13px}.dot-success{background:#488149}.dot-fallback{background:#b38c38}.probe-placeholder{color:var(--muted);padding:15px 0 7px;text-align:center}.placeholder-icon{color:#8b9b78;display:block;font-size:26px;margin-bottom:9px}.probe-placeholder p{font-size:11px;line-height:1.7}.probe-placeholder code{color:#7d8d6d;display:inline-block;font-size:10px;margin-top:14px}.result-list{margin:15px 0 0}.result-list>div{align-items:center;display:flex;gap:10px;justify-content:space-between;padding:8px 0}.result-list dt{color:var(--muted);font-size:10px}.result-list dd{font-size:12px;font-variant-numeric:tabular-nums;font-weight:650;margin:0}.result-list code{background:#e7eedc;border-radius:3px;color:var(--green);padding:2px 6px}.result-message{color:var(--muted);font-size:10px;line-height:1.8;margin-top:15px}.error-message{color:#944830}.details-section{max-width:920px;padding:45px 0 0}.details-section h2{font-size:18px;letter-spacing:-.4px;margin-bottom:14px}.details-section>p{color:var(--muted);font-size:11px;line-height:1.9;margin-top:10px}.details-section p code{background:#e9eddf;border-radius:3px;color:#536449;overflow-wrap:anywhere;padding:2px 4px}.artifact-details{border-top:1px solid var(--line);margin-top:23px}.artifact-details summary{align-items:center;cursor:pointer;display:flex;font-size:12px;font-weight:600;justify-content:space-between;list-style:none;padding:17px 0}.artifact-details summary::-webkit-details-marker{display:none}.artifact-details summary>span{font-size:18px;font-weight:400}.artifact-details[open] summary>span{transform:rotate(45deg)}.artifact-list{background:#edf0e6;border-radius:7px;margin:0 0 20px;padding:15px 20px}.artifact-list>div{display:grid;font-size:11px;gap:15px;grid-template-columns:100px 1fr;line-height:1.8;padding:5px 0}.artifact-list dt{color:var(--muted)}.artifact-list dd{margin:0;overflow-wrap:anywhere}.artifact-list a{text-underline-offset:3px}.notice{background:var(--paper);border:1px solid var(--line);border-radius:10px;font-size:13px;line-height:1.8;padding:25px}.notice-error{background:#fff9f6;border-color:#e6c7bc;color:#944830}.site-footer{align-items:center;border-top:1px solid var(--line);color:var(--muted);display:flex;font-size:10px;gap:20px;justify-content:space-between;margin-top:45px;padding:25px 0 30px}.site-footer>span:first-child{color:var(--ink);font-weight:600}@media (max-width:900px){.hero{gap:30px;padding:55px 0}h1{font-size:39px}.flow-card{padding:20px}.flow-line{gap:9px;padding:15px 10px}.flow-line div span{font-size:9px}.metric-card{padding:20px 16px}.metric-label{font-size:10px}.probe-section{gap:30px;padding:28px}}@media (max-width:680px){.site-shell{width:calc(100% - 36px)}.site-header{gap:10px;min-height:76px}.wordmark{font-size:12px;gap:8px}.brand-icon{border-radius:8px;font-size:13px;height:29px;width:29px}.stack-label{font-size:9px;gap:5px}.hero{gap:30px;grid-template-columns:1fr;padding:40px 0}h1{font-size:clamp(33px,8.5vw,47px);letter-spacing:-1.7px}.hero-description{font-size:14px;margin-top:20px}.flow-card{padding:23px}.flow-line{padding:17px 13px}.flow-line div span{font-size:10px}h2{font-size:22px}.section-heading{align-items:flex-start;flex-direction:column;gap:9px}.metric-grid{gap:10px;grid-template-columns:1fr}.metric-card{padding:22px}.metric-label{font-size:12px}.metric-value{font-size:33px}.measurement-note,.metric-card>p{font-size:11px}.steps-section{margin-top:38px}.steps-grid{grid-template-columns:1fr}.step-card{padding:24px 0}.step-card+.step-card{border-left:0;border-top:1px solid var(--line);padding:24px 0}.step-number{margin-bottom:11px}.step-card p{font-size:13px}.step-tag{margin-top:13px}.probe-section{gap:25px;grid-template-columns:1fr;margin-top:35px;padding:24px 18px}.probe-copy>p:not(.eyebrow){font-size:13px;max-width:none}.probe-result{min-height:220px}.details-section{padding-top:32px}.details-section>p{font-size:12px}.artifact-list{padding:15px}.artifact-list>div{gap:0;grid-template-columns:1fr;padding:7px 0}.site-footer{align-items:flex-start;flex-direction:column;gap:9px;margin-top:30px}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.primary-button{transition:none}}