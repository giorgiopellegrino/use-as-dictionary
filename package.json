{
  "name": "use-as-dictionary",
  "version": "1.0.0",
  "private": false,
  "description": "Webpack and Vite plugins for Compression Dictionary Transport with Shared Brotli dictionaries",
  "exports": {
    "./webpack": "./src/webpack.cjs",
    "./vite": "./src/vite.cjs"
  },
  "files": [
    "src/"
  ],
  "license": "MIT",
  "author": "Giorgio Pellegrino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giorgiopellegrino/use-as-dictionary.git"
  },
  "homepage": "https://github.com/giorgiopellegrino/use-as-dictionary#readme",
  "bugs": {
    "url": "https://github.com/giorgiopellegrino/use-as-dictionary/issues"
  },
  "keywords": [
    "webpack",
    "webpack-plugin",
    "vite",
    "vite-plugin",
    "compression-dictionary-transport",
    "brotli",
    "dcb"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/vue-webpack",
    "examples/vue-vite"
  ],
  "scripts": {
    "build:webpack": "npm run build --workspace @use-as-dictionary/example-vue-webpack",
    "build:vite": "npm run build --workspace @use-as-dictionary/example-vue-vite",
    "build:all": "npm run build:webpack && npm run build:vite",
    "build:watch:webpack": "npm run build:watch --workspace @use-as-dictionary/example-vue-webpack",
    "serve:webpack": "npm run serve --workspace @use-as-dictionary/example-vue-webpack",
    "serve:vite": "npm run serve --workspace @use-as-dictionary/example-vue-vite",
    "start:webpack": "npm start --workspace @use-as-dictionary/example-vue-webpack",
    "start:vite": "npm start --workspace @use-as-dictionary/example-vue-vite",
    "test": "npm run build:all && node --test test/*.test.cjs",
    "test:webpack": "node --test test/webpack-plugin.test.cjs",
    "test:vite": "node --test test/vite-plugin.test.cjs",
    "test:browser": "npm run build:all && playwright test",
    "test:browser:webpack": "npm run test:browser -- --project=webpack",
    "test:browser:vite": "npm run test:browser -- --project=vite",
    "test:package": "node scripts/check-package.cjs"
  },
  "dependencies": {
    "brotli-wasm-custom-dictionary": "3.1.1"
  },
  "peerDependencies": {
    "webpack": "^5.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "webpack": "5.111.1",
    "vite": "8.3.4"
  }
}
